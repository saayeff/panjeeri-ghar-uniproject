<%-- Cart Drawer — uses class names from panjeerigharmastercssfile.css --%>
<style>
/* Cart drawer extras */
.cd-loading { padding: 16px 0; }
.cart-empty-sub { font-size: 13px; color: rgba(56,28,6,0.6); margin-top: -8px; }
</style>

<div class="cart-overlay" id="cart-overlay" onclick="closeCartDrawer()"></div>

<div class="cart-drawer" id="cart-drawer" role="dialog" aria-label="Shopping cart">

    <div class="cart-drawer-header">
        <span class="cart-drawer-title">
            Your Cart
            <span id="cd-count"></span>
        </span>
        <button class="cart-close" onclick="closeCartDrawer()" aria-label="Close">&#10005;</button>
    </div>

    <div class="cart-drawer-body" id="cd-body">
        <div class="cd-loading"><div class="cd-spin"></div>Loading&hellip;</div>
    </div>

    <div class="cart-drawer-footer" id="cd-footer" style="display:none;">
        <div class="cart-total-row">
            <span class="cart-total-label">Estimated Total</span>
            <span class="cart-total-amount" id="cd-amt">&#8377;0</span>
        </div>
        <div class="cart-total-note">Taxes &amp; shipping calculated at checkout</div>
        <a href="${pageContext.request.contextPath}/checkout" class="btn-checkout">Checkout</a>
    </div>
</div>

<script>
(function(){
    var CTX = '${pageContext.request.contextPath}';
    var API  = CTX + '/cart-api';
    var open = false;
    var _handler = null;

    function el(id){ return document.getElementById(id); }

    window.openCartDrawer = function(){
        el('cart-overlay').classList.add('open');
        el('cart-drawer').classList.add('open');
        document.body.style.overflow = 'hidden';
        open = true;
        loadCart();
    };
    window.closeCartDrawer = function(){
        el('cart-overlay').classList.remove('open');
        el('cart-drawer').classList.remove('open');
        document.body.style.overflow = '';
        open = false;
    };
    document.addEventListener('keydown', function(e){
        if(e.key==='Escape' && open) closeCartDrawer();
    });

    function skeletonHtml(){
        var row = '<div class="cd-sk-row">'+
            '<div class="sk cd-sk-thumb"></div>'+
            '<div class="cd-sk-lines">'+
                '<div class="sk sk-line w80"></div>'+
                '<div class="sk sk-line w50"></div>'+
                '<div class="sk sk-line w40"></div>'+
            '</div>'+
        '</div>';
        return '<div class="cd-loading">' + row + row + row + '</div>';
    }

    function loadCart(){
        el('cd-body').innerHTML = skeletonHtml();
        el('cd-footer').style.display = 'none';
        fetch(API,{credentials:'same-origin'})
            .then(function(r){return r.json();})
            .then(function(d){ render(d); setBadge(d.count); })
            .catch(function(){ el('cd-body').innerHTML='<div style="padding:32px;text-align:center;font-size:13px;color:rgba(56,28,6,0.5);">Could not load cart.</div>'; });
    }

    function render(d){
        var body = el('cd-body');
        var foot = el('cd-footer');
        var cnt  = el('cd-count');

        if(_handler){ body.removeEventListener('click',_handler); _handler=null; }

        if(!d.loggedIn || !d.items || d.items.length===0){
            cnt.textContent='';
            foot.style.display='none';
            body.innerHTML = emptyHtml(d.loggedIn);
            return;
        }

        cnt.textContent = d.count;
        el('cd-amt').innerHTML = '&#8377;'+parseFloat(d.total).toFixed(2);
        foot.style.display='';

        var html='';
        for(var i=0;i<d.items.length;i++) html+=itemHtml(d.items[i]);
        html+=collapseHtml('Special Instructions',
            '<textarea style="width:100%;box-sizing:border-box;padding:10px 14px;border:1px solid var(--color-border);border-radius:16px;font-family:var(--font-body);font-size:13px;color:var(--color-brown);background:var(--color-white);resize:vertical;min-height:72px;outline:none;" id="cd-notes" placeholder="Add a note\u2026"></textarea>');
        html+=collapseHtml('Discount Code',
            '<div style="display:flex;gap:8px;">' +
                '<input type="text" id="cd-disc" placeholder="Enter code" style="flex:1;padding:10px 14px;border:1px solid var(--color-border);border-radius:var(--radius-inputs);font-family:var(--font-body);font-size:13px;color:var(--color-brown);background:var(--color-white);outline:none;">' +
                '<button onclick="cdApply()" type="button" style="padding:10px 16px;background:var(--color-brown);color:var(--color-white);border:none;border-radius:var(--radius-primary-btn);font-family:var(--font-body);font-size:12px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;cursor:pointer;">Apply</button>' +
            '</div>' +
            '<div id="cd-disc-msg" style="font-size:11px;margin-top:5px;display:none;"></div>');
        body.innerHTML=html;

        _handler=function(e){
            var minus=e.target.closest('.qty-btn-m');
            var plus =e.target.closest('.qty-btn-p');
            var del  =e.target.closest('.cart-item-delete');
            var ctog =e.target.closest('.cart-collapsible-btn');
            if(minus)  mutate('update',{cartId:minus.dataset.id, quantity:+minus.dataset.q-1});
            else if(plus)  mutate('update',{cartId:plus.dataset.id,  quantity:+plus.dataset.q+1});
            else if(del)   mutate('remove',{cartId:del.dataset.id});
            else if(ctog){ ctog.classList.toggle('open'); ctog.nextElementSibling.classList.toggle('open'); }
        };
        body.addEventListener('click',_handler);
    }

    function itemHtml(it){
        var img = it.imageUrl
            ? '<img src="'+esc(it.imageUrl)+'" alt="'+esc(it.name)+'" loading="lazy">'
            : '';
        return '<div class="cart-item">'+
            '<div class="cart-item-img">'+img+'</div>'+
            '<div class="cart-item-details">'+
                '<div class="cart-item-name">'+esc(it.name)+'</div>'+
                '<div class="cart-item-price">'+it.weightGrams+'g &nbsp;&bull;&nbsp; &#8377;'+parseFloat(it.subtotal).toFixed(2)+'</div>'+
                '<div class="qty-control">'+
                    '<button class="qty-btn qty-btn-m" data-id="'+it.cartId+'" data-q="'+it.quantity+'" aria-label="Decrease">&#8722;</button>'+
                    '<span class="qty-value">'+it.quantity+'</span>'+
                    '<button class="qty-btn qty-btn-p" data-id="'+it.cartId+'" data-q="'+it.quantity+'" aria-label="Increase">+</button>'+
                '</div>'+
            '</div>'+
            '<button class="cart-item-delete" data-id="'+it.cartId+'" aria-label="Remove">&#10005;</button>'+
        '</div>';
    }

    function collapseHtml(label, content){
        return '<div class="cart-collapsible">'+
            '<button class="cart-collapsible-btn" type="button">'+label+
                '<span style="font-size:10px;transition:transform 0.2s;display:inline-block;">&#9660;</span>'+
            '</button>'+
            '<div class="cart-collapsible-content">'+content+'</div>'+
        '</div>';
    }

    function emptyHtml(loggedIn){
        if(!loggedIn){
            return '<div class="cart-empty">'+
                '<p>Your cart is empty</p>'+
                '<p class="cart-empty-sub">Sign in to view your cart</p>'+
                '<a href="'+CTX+'/login" class="btn-checkout" style="display:inline-block;width:auto;padding:14px 28px;margin-top:8px;text-decoration:none;">Sign In</a>'+
            '</div>';
        }
        return '<div class="cart-empty">'+
            '<p>Your cart is empty</p>'+
            '<a href="'+CTX+'/home" class="btn-checkout" style="display:inline-block;width:auto;padding:14px 28px;margin-top:8px;text-decoration:none;" onclick="closeCartDrawer()">Continue Shopping</a>'+
        '</div>';
    }

    function mutate(action,params){
        var body='action='+encodeURIComponent(action);
        for(var k in params) body+='&'+encodeURIComponent(k)+'='+encodeURIComponent(params[k]);
        fetch(API,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},credentials:'same-origin',body:body})
            .then(function(r){return r.json();})
            .then(function(d){ render(d); setBadge(d.count); });
    }

    window.cartAdd = function(productId, qty, shouldOpen){
        var body='action=add&productId='+encodeURIComponent(productId)+'&quantity='+encodeURIComponent(qty||1);
        fetch(API,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},credentials:'same-origin',body:body})
            .then(function(r){return r.json();})
            .then(function(d){
                setBadge(d.count);
                if(shouldOpen!==false) window.openCartDrawer();
            });
    };

    function setBadge(n){
        /* update both possible badge elements */
        var b1=el('nb-cart-badge');
        if(b1){ b1.textContent=n>0?n:''; b1.style.display=n>0?'flex':'none'; }
        /* legacy support */
        document.querySelectorAll('.cart-count-badge').forEach(function(b){
            b.textContent=n>0?n:''; b.style.display=n>0?'flex':'none';
        });
    }

    window.refreshCartBadge = function(){
        fetch(API,{credentials:'same-origin'})
            .then(function(r){return r.json();})
            .then(function(d){setBadge(d.count);})
            .catch(function(){});
    };

    window.cdApply = function(){
        var i=el('cd-disc'), m=el('cd-disc-msg');
        if(!i||!m) return;
        var c=i.value.trim().toUpperCase();
        if(!c){m.style.cssText='display:block;color:var(--color-error);';m.textContent='Enter a code first.';return;}
        m.style.cssText='display:block;color:var(--color-error);';
        m.textContent='"'+c+'" is not a valid discount code.';
    };

    function esc(s){ return s?String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'):''; }

    document.addEventListener('DOMContentLoaded', window.refreshCartBadge);
})();
</script>
